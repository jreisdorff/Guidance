# Copy this file to ".env" and fill in the values below.

# Your Anthropic API key — enables AI affirmations written by Claude.
# Get one at https://console.anthropic.com/ -> Settings -> API Keys.
# Without it, the app falls back to its built-in local engine.
ANTHROPIC_API_KEY=sk-ant-...

# Passcode gate. If set, visitors must enter this passcode to see the site,
# and it also protects the /api/affirm endpoint (so no one else can spend your
# API credits). Leave blank to disable the gate (open site — fine for local dev).
DIVINITY_PASSCODE=

# Optional: change the backend port (must match vite.config.js proxy if you do).
# PORT=8787

# --- Mobile app (Guidance) Google sign-in ---
# These power the mobile app's Google login (see mobile/). The web app does not
# use them — it keeps the passcode gate above.
#
# Comma-separated Google OAuth client IDs whose ID tokens the backend accepts.
# Include your WEB client ID (the native mobile library mints ID tokens with the
# web client as audience) and, optionally, your iOS client ID.
GOOGLE_CLIENT_IDS=

# Secret used to sign the session JWT the backend issues to the mobile app after
# a successful Google sign-in. Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=
