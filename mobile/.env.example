# Copy to "mobile/.env" and fill in. Expo inlines EXPO_PUBLIC_* vars at build
# time. These are NOT secrets — Google OAuth *client IDs* are public by design.

# Where the backend lives.
#  - iOS simulator:      http://localhost:8787
#  - Android emulator:   http://10.0.2.2:8787
#  - Physical device:    http://<your-computer-LAN-IP>:8787
#  - Production:         https://your-app.vercel.app
EXPO_PUBLIC_API_URL=http://localhost:8787

# Google OAuth *Web* client ID (from Google Cloud Console). REQUIRED — the native
# sign-in returns an ID token with this as its audience, and the backend
# (GOOGLE_CLIENT_IDS) must include it.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Google OAuth *iOS* client ID (from Google Cloud Console). Needed for iOS.
# Its reversed form also goes in app.json under the google-signin plugin's
# iosUrlScheme (com.googleusercontent.apps.<IOS_CLIENT_ID>).
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
