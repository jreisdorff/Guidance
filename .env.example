# Copy this file to ".env" and fill in the values below.

# Your Anthropic API key — enables AI affirmations written by Claude.
# Get one at https://console.anthropic.com/ -> Settings -> API Keys.
# Without it, the app falls back to its built-in local engine.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: change the backend port (must match vite.config.js proxy if you do).
# PORT=8787

# --- Firebase Authentication (Google + phone sign-in) ---
# Both the web app and the mobile app sign in with Firebase and send a Firebase
# ID token to /api/affirm; the backend verifies it with the Admin SDK.

# Backend: the Service Account JSON from Firebase Console -> Project settings ->
# Service accounts -> Generate new private key. Paste it here as a single line —
# either raw JSON or base64-encoded (base64 is easiest to keep on one line):
#   base64 -i serviceAccount.json | pbcopy
FIREBASE_SERVICE_ACCOUNT=

# Web app (Vite): the values from Firebase Console -> Project settings ->
# General -> your Web app -> SDK setup and configuration (firebaseConfig).
# These are NOT secret (they ship in the browser bundle).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
